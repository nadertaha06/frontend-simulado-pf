# Copie para .env (cp .env.example .env) e preencha.
# Na Vercel, cadastre as mesmas 3 primeiras em Settings > Environment Variables.
VITE_AUTH0_DOMAIN=dev-xxxxxxxx.us.auth0.com
VITE_AUTH0_CLIENT_ID=coloque-o-client-id-da-aplicacao-spa
VITE_AUTH0_AUDIENCE=https://avaliacoes-api

# Só para o `npm run dev`: para onde o proxy manda /api
#   backend local: http://localhost:8000   |   backend na AWS: http://13.220.42.157:8080
VITE_PROXY_TARGET=http://localhost:8000
